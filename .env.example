# Proveedor de modelo de lenguaje (la clave NUNCA va en el repositorio, el front ni los logs)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Controles de costo y robustez del agente
MAX_ITERACIONES_POR_TURNO=25
MAX_TOKENS_POR_SESION=200000
MAX_TOKENS_POR_DIA=3000000
LLM_TIMEOUT_MS=60000

# Servidor
PORT=3000
# Opcional: protege el link público. Si se define, el chat pide esta clave (cabecera x-access-key)
# En el despliegue de demo se usa la clave simulada 'periferia-reto03-demo' (ver render.yaml); en local puede quedar vacía.
ACCESS_KEY=
